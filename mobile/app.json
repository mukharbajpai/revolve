{
  "expo": {
    "name": "Revolve",
    "slug": "revolve-mobile",
    "version": "1.0.0",
    "description": "Revolve customer recovery-to-performance demo",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "revolve",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.revolve.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Revolve Customer",
      "shortName": "Revolve",
      "lang": "en",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "orientation": "portrait",
      "themeColor": "#426B5A",
      "backgroundColor": "#F7F8F5",
      "barStyle": "default",
      "description": "Your integrated recovery-to-performance journey."
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8cbc9065-2943-4c17-b600-ceb2e65df22b"
      }
    }
  }
}
